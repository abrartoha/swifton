# ── Supabase ────────────────────────────────────────────────
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Bypasses Row-Level Security — used only in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Group details (shown in footer / legal pages) ───────────
NEXT_PUBLIC_GROUP_ABN=00 000 000 000
NEXT_PUBLIC_CONTACT_EMAIL=info@swiftongroup.com.au
